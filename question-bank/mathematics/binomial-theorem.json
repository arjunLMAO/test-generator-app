    {
      "id": "MAT-BIN-M001",
      "subject": "Mathematics",
      "chapter": "Binomial Theorem",
      "topic": "Binomial Coefficient Weighted Series Summations",
      "category": "Binomial Theorem :: Advanced Mathematical Structure (Type 1)",
      "difficulty": "hard",
      "type": "mcq",
      "question": "What is the remainder when $7^{103}$ is divided by $25$ in [Binomial Theorem]?",
      "options": [
        "$18$",
        "$7$",
        "$1$",
        "$14$"
      ],
      "correctAnswer": "A",
      "solution": "$7^2 = 49 = 50 - 1 = 2(25) - 1$. Then $7^{103} = 7 \\times (7^2)^{51} = 7 \\times (50 - 1)^{51} = 7 \\times (25k - 1) = 25k' - 7 = 25(k' - 1) + 18$. The remainder is $18$.",
      "explanation": "Solve using rigorous mathematical proofs and transformations in Binomial Theorem.",
      "possibleErrorType": "Formula mistake",
      "isReactionBased": false,
      "image": null,
      "source": "question_bank",
      "tags": [
        "JEE Main",
        "JEE Advanced",
        "Binomial Theorem",
        "Binomial Coefficient Weighted Series Summations",
        "conceptual"
      ]
    },
