    {
      "id": "MAT-TRG-M001",
      "subject": "Mathematics",
      "chapter": "Trigonometry",
      "topic": "Inverse Trigonometric Principal Domains & Sums",
      "category": "Trigonometry :: Advanced Mathematical Structure (Type 1)",
      "difficulty": "hard",
      "type": "mcq",
      "question": "Evaluate the exact value of the expression in [Trigonometry]:\n$$\\tan\\left(2 \\arctan\\left(\\frac{1}{3}\\right) + \\arctan\\left(\\frac{1}{7}\\right)\\right)$$",
      "options": [
        "$1$",
        "$\\frac{1}{\\sqrt{3}}$",
        "$\\sqrt{3}$",
        "$\\frac{4}{3}$"
      ],
      "correctAnswer": "A",
      "solution": "$2 \\arctan(1/3) = \\arctan\\left(\\frac{2/3}{1 - 1/9}\\right) = \\arctan\\left(\\frac{2/3}{8/9}\\right) = \\arctan\\left(\\frac{3}{4}\\right)$. Then $\\arctan(3/4) + \\arctan(1/7) = \\arctan\\left(\\frac{3/4 + 1/7}{1 - (3/4)(1/7)}\\right) = \\arctan\\left(\\frac{25/28}{25/28}\\right) = \\arctan(1) = \\frac{\\pi}{4}$. Thus the tangent is $\\tan(\\pi/4) = 1$.",
      "explanation": "Solve using rigorous mathematical proofs and transformations in Trigonometry.",
      "possibleErrorType": "Formula mistake",
      "isReactionBased": false,
      "image": null,
      "source": "question_bank",
      "tags": [
        "JEE Main",
        "JEE Advanced",
        "Trigonometry",
        "Inverse Trigonometric Principal Domains & Sums",
        "conceptual"
      ]
    },
